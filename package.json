{
  "name": "iceiq-react",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:cards": "node scripts/check-cards.mjs",
    "test:cards": "node --test src/lib/cardEngine.test.mjs src/lib/cardProgress.test.mjs src/lib/cardSteps.test.mjs src/lib/cardLibrary.test.mjs",
    "report:acquisition": "node --env-file=.env scripts/acquisition-report.mjs",
    "build": "vite build && node scripts/generate-landing-pages.mjs",
    "preview": "vite preview",
    "deploy:functions": "npx --yes firebase-tools deploy --only functions",
    "deploy:prod": "npm run build && npx --yes firebase-tools deploy --only hosting:prod",
    "deploy:v2": "npm run build && npx --yes firebase-tools deploy --only hosting:v2"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@capacitor-community/in-app-review": "^8.0.0",
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@stripe/stripe-js": "^2.1.7",
    "autoprefixer": "^10.4.0",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.6.1",
    "firebase-functions": "^7.0.5",
    "lucide-react": "^0.309.0",
    "nosleep.js": "^0.12.0",
    "postcss": "^8.4.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.69.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^6.20.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@tailwindcss/forms": "^0.5.11",
    "@types/glob": "^8.1.0",
    "@types/lodash": "^4.17.21",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "typescript": "^5.0.0",
    "vite": "^4.4.0"
  }
}
