# Copy this file to .env and fill in your own values.
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_auth_domain
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_key

# RevenueCat (publik SDK-nyckel för iOS) och flaggan som slår på köp i appen (v1.1)
VITE_REVENUECAT_IOS_KEY=
VITE_IAP_ENABLED=false

# App Store: Sverige öppnas när trader-statusen är verifierad (sätt true då). PT = leverantörs-token för kampanjspårning (App Store Connect, App Analytics, Campaigns).
VITE_APP_STORE_SE_OPEN=false
VITE_APP_STORE_PT=
