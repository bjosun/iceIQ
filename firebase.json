
{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "hosting": [
    {
      "target": "prod",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "source": "iceiq.app",
          "destination": "https://www.iceiq.app",
          "type": 301
        }
      ],
      "rewrites": [
        {
          "source": "/hockey-tracking-app",
          "destination": "/hockey-tracking-app.html"
        },
        {
          "source": "/youth-hockey-stats",
          "destination": "/youth-hockey-stats.html"
        },
        {
          "source": "/hockey-scouting-template",
          "destination": "/hockey-scouting-template.html"
        },
        {
          "source": "/measure-corsi-youth-hockey",
          "destination": "/measure-corsi-youth-hockey.html"
        },
        {
          "source": "/game-tracking-template",
          "destination": "/game-tracking-template.html"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "v2",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/hockey-tracking-app",
          "destination": "/hockey-tracking-app.html"
        },
        {
          "source": "/youth-hockey-stats",
          "destination": "/youth-hockey-stats.html"
        },
        {
          "source": "/hockey-scouting-template",
          "destination": "/hockey-scouting-template.html"
        },
        {
          "source": "/measure-corsi-youth-hockey",
          "destination": "/measure-corsi-youth-hockey.html"
        },
        {
          "source": "/game-tracking-template",
          "destination": "/game-tracking-template.html"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}